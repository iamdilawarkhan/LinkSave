<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.user.linksave"
    android:versionCode="19"
    android:versionName="1.18">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- direct file write to Downloads on pre-29 devices (29+ uses MediaStore) -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- v1.18 in-app updater: lets the app open the system installer
         for a downloaded update APK. A normal permission (no runtime
         prompt); the user still grants "install unknown apps" for
         LinkSave once, in Settings, on the first update — the app
         opens that screen itself when needed. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- v1.12: the v1.11 auto-download feature (accessibility service +
         overlay bubble) was removed because Google Play Protect blocked
         the v1.11 install ("App blocked... sensitive data"). No
         accessibility service, no overlay permission, no foreground
         service, no boot receiver — the app installs cleanly. -->

    <application
        android:label="LinkSave"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:allowBackup="true"
        android:supportsRtl="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- v1.5: appear in the Share sheet for text links. Sharing a
                 video link straight to LinkSave needs no clipboard read,
                 so Android's "pasted from your clipboard" toast never
                 appears. singleTop above routes repeat shares to
                 onNewIntent instead of stacking a second activity. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <!-- v1.18: hands the downloaded update APK to the system
             installer as a content:// URI (file:// URIs are blocked
             since Android 7). Serves only the update dir in the app
             cache — see res/xml/file_paths.xml. Not exported; the
             installer gets one-shot read access via the intent flag. -->
        <provider
            android:name=".UpdateFileProvider"
            android:authorities="com.user.linksave.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
